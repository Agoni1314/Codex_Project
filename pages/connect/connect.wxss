page {
  min-height: 100%;
  background: linear-gradient(180deg, #2e8b57 0%, #48d1cc 100%);
  color: #12352a;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 28rpx 48rpx;
}

.header {
  padding: 20rpx 4rpx 28rpx;
  color: #ffffff;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.88;
}

.status-card,
.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.1);
}

.status-row,
.device-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.mode-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  border-radius: 14rpx;
  background: rgba(46, 139, 87, 0.1);
}

.mode-tab {
  padding: 16rpx 10rpx;
  border-radius: 12rpx;
  color: rgba(18, 53, 42, 0.68);
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.mode-tab.active {
  color: #ffffff;
  background: #2e8b57;
}

.label,
.summary-label {
  font-size: 24rpx;
  color: rgba(18, 53, 42, 0.62);
}

.device-name {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  word-break: break-all;
}

.badge {
  flex-shrink: 0;
  min-width: 112rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  text-align: center;
}

.badge.online {
  color: #ffffff;
  background: #2e8b57;
}

.badge.offline {
  color: #8a3b12;
  background: #ffe3cc;
}

.offline-tip {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 227, 204, 0.8);
  color: #8a3b12;
  font-size: 26rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.summary-item {
  padding: 20rpx;
  border-radius: 14rpx;
  background: rgba(46, 139, 87, 0.1);
}

.summary-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #2e8b57;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.action-row.compact {
  margin: 24rpx 0 0;
}

.primary-btn,
.ghost-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  line-height: 88rpx;
}

.primary-btn {
  color: #ffffff;
  background: #12352a;
}

.ghost-btn {
  color: #12352a;
  background: rgba(255, 255, 255, 0.88);
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.section-title.small {
  margin: 24rpx 0 6rpx;
  font-size: 26rpx;
}

.empty {
  padding: 28rpx 0;
  color: rgba(18, 53, 42, 0.58);
  font-size: 26rpx;
  text-align: center;
}

.device-item {
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(18, 53, 42, 0.1);
}

.device-title {
  font-size: 29rpx;
  font-weight: 600;
}

.device-id {
  margin-top: 8rpx;
  max-width: 470rpx;
  color: rgba(18, 53, 42, 0.56);
  font-size: 22rpx;
  word-break: break-all;
}

.rssi {
  flex-shrink: 0;
  color: rgba(18, 53, 42, 0.62);
  font-size: 23rpx;
}

.log-item {
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(18, 53, 42, 0.08);
  color: rgba(18, 53, 42, 0.72);
  font-size: 24rpx;
  line-height: 1.45;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(18, 53, 42, 0.08);
}

.input-row text {
  width: 90rpx;
  color: rgba(18, 53, 42, 0.62);
  font-size: 26rpx;
}

.input-row input {
  flex: 1;
  height: 72rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: rgba(46, 139, 87, 0.1);
  color: #12352a;
  font-size: 28rpx;
}

.protocol-tip {
  margin-top: 18rpx;
  color: rgba(18, 53, 42, 0.62);
  font-size: 24rpx;
  line-height: 1.45;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.1);
}

.wifi-search {
  margin: 24rpx 0 0;
  background: rgba(46, 139, 87, 0.1);
  box-shadow: none;
}

.search-title {
  color: #12352a;
  font-size: 28rpx;
  font-weight: 700;
}

.search-desc {
  margin-top: 8rpx;
  color: rgba(18, 53, 42, 0.62);
  font-size: 24rpx;
  line-height: 1.4;
}

.scan-orbit {
  position: relative;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border: 5rpx solid rgba(46, 139, 87, 0.18);
  border-top-color: #2e8b57;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.scan-dot {
  position: absolute;
  top: -7rpx;
  left: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-left: -7rpx;
  border-radius: 50%;
  background: #2e8b57;
  box-shadow: 0 0 18rpx rgba(46, 139, 87, 0.7);
}

.radar {
  position: relative;
  flex-shrink: 0;
  width: 82rpx;
  height: 82rpx;
}

.radar-wave,
.radar-core {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.radar-wave {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(46, 139, 87, 0.58);
  animation: radarPulse 1.5s ease-out infinite;
}

.wave-two {
  animation-delay: 0.55s;
}

.radar-core {
  width: 24rpx;
  height: 24rpx;
  background: #2e8b57;
  box-shadow: 0 0 20rpx rgba(46, 139, 87, 0.6);
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes radarPulse {
  0% {
    opacity: 0.75;
    transform: translate(-50%, -50%) scale(0.55);
  }

  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(2.3);
  }
}

.wifi-list {
  margin-top: 14rpx;
}

.wifi-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(18, 53, 42, 0.1);
}

.connect-text {
  flex-shrink: 0;
  color: #2e8b57;
  font-size: 25rpx;
  font-weight: 700;
}
