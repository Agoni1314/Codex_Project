page {
  height: 100%;
  background: #2e8b57;
  color: #12352a;
}

.page {
  position: relative;
  height: 100vh;
  overflow: hidden;
}

.map {
  width: 100%;
  height: 100%;
}

.top-panel {
  position: absolute;
  top: 36rpx;
  left: 28rpx;
  right: 28rpx;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(46, 139, 87, 0.9);
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.16);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.subtitle {
  margin-top: 6rpx;
  font-size: 25rpx;
  opacity: 0.9;
}

.info-card {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 40rpx;
  box-sizing: border-box;
  padding: 28rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.18);
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.info-item {
  padding: 20rpx;
  border-radius: 14rpx;
  background: rgba(46, 139, 87, 0.1);
}

.info-value {
  color: #2e8b57;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.15;
}

.info-label,
.last-time {
  color: rgba(18, 53, 42, 0.62);
  font-size: 24rpx;
}

.last-time {
  margin-top: 20rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.primary-btn,
.ghost-btn {
  flex: 1;
  height: 82rpx;
  border-radius: 14rpx;
  font-size: 29rpx;
  line-height: 82rpx;
}

.primary-btn {
  color: #ffffff;
  background: #12352a;
}

.ghost-btn {
  color: #12352a;
  background: rgba(46, 139, 87, 0.12);
}
