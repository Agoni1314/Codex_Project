@import "../connect/connect.wxss";

.risk-card,
.stat-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.1);
}

.risk-card.warning {
  background: rgba(255, 239, 204, 0.92);
}

.risk-card.danger {
  background: rgba(255, 224, 224, 0.94);
}

.risk-label {
  color: rgba(18, 53, 42, 0.62);
  font-size: 24rpx;
}

.risk-value {
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #2e8b57;
}

.risk-card.warning .risk-value {
  color: #b36b00;
}

.risk-card.danger .risk-value {
  color: #b42318;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.stat-value {
  color: #2e8b57;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.15;
}

.stat-label {
  margin-top: 8rpx;
  color: rgba(18, 53, 42, 0.62);
  font-size: 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(18, 53, 42, 0.08);
}

.info-label {
  flex-shrink: 0;
  color: rgba(18, 53, 42, 0.62);
  font-size: 25rpx;
}

.info-value {
  color: #12352a;
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
}

.desc {
  color: rgba(18, 53, 42, 0.72);
  font-size: 26rpx;
  line-height: 1.6;
}

.clear-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 18rpx;
  border-radius: 14rpx;
  color: #8a3b12;
  background: rgba(255, 255, 255, 0.88);
  font-size: 30rpx;
  line-height: 88rpx;
}
